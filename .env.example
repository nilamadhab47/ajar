# Copy to .env.local. All integration endpoints come from here; nothing is hard-coded.

# REST base URL of your backend, e.g. https://api.example.com/v1 (unused in mock mode)
NEXT_PUBLIC_API_BASE_URL=

# WebSocket endpoint of your realtime service, e.g. wss://rt.example.com/office (unused in mock mode)
NEXT_PUBLIC_WS_URL=

# mock      -> in-browser simulation, no server needed (default)
# websocket -> WebSocketRealtimeAdapter against NEXT_PUBLIC_WS_URL
NEXT_PUBLIC_REALTIME_MODE=mock
